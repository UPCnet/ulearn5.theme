<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="ulearn">

    <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
    <include package="z3c.jbot" file="meta.zcml" />

    <!-- BASE.AUTHENTICATED CAMBIO -->
    <browser:page
        name="profile"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        class=".user_profile.userProfile"
        permission="zope2.View"
    />

    <browser:page
        for="*"
        name="plone_javascript_variables.js"
        class=".jsvariables.JSVariables"
        permission="zope.Public"
    />

    <browser:page
        name="get_news"
        for="*"
        class=".get_news.getNews"
        permission="zope.Public"
    />

    <!-- Comments viewlet -->
    <browser:viewlet
        name="plone.comments"
        for="Products.CMFCore.interfaces.IContentish"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        manager="plone.app.layout.viewlets.interfaces.IBelowContentBody"
        view="plone.app.layout.globals.interfaces.IViewView"
        class="plone.app.discussion.browser.comments.CommentsViewlet"
        permission="zope2.View"
    />

    <browser:page
        name="search"
        class=".search.Search"
        permission="zope2.View"
        for="plone.app.layout.navigation.interfaces.INavigationRoot"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/search.pt"
    />

    <browser:resource
        name="ulearnSchemaeditor.js"
        file="schemaeditor.js"
    />

    <browser:page
      name="macros-comunitats-header"
      for="*"
      permission="zope.Public"
      template="viewlets_templates/header_macros.pt"
      />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="allcommunities"
        class="ulearn5.theme.browser.views.AllCommunities"
        permission="zope2.View"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        template="views_templates/allcommunities.pt"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="my-communities-ajax"
        class="ulearn5.theme.browser.views.communitiesAJAX"
        permission="zope2.View"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/my_communities_ajax.pt"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="dynamic.css"
        class="ulearn5.theme.browser.views.dynamicCSS"
        permission="zope2.View"
        for="zope.interface.Interface"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="ulearncustom.css"
        class="ulearn5.theme.browser.views.CustomCSS"
        permission="zope2.View"
        for="zope.interface.Interface"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/ulearncustom.css.pt"
        />


    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="searchUser"
        class="ulearn5.theme.browser.views.SearchUser"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <browser:page 
        name="searchUsers"
        class="ulearn5.theme.browser.views.searchUsers"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="gw_type_ahead_search"
        class="ulearn5.theme.browser.views.TypeAheadSearch"
        permission="zope2.View"
        for="zope.interface.Interface"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <browser:page 
        name="filtered_contents_search_view"
        class="ulearn5.theme.browser.views.FilteredContentsSearchView"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/filtered_contents_search.pt"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="search_filtered_content"
        class="ulearn5.theme.browser.views.SearchFilteredContentAjax"
        permission="zope2.View"
        for="zope.interface.Interface"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/filtered_contents_search_ajax.pt"
        />

    <!-- BASE.AUTHENTICATED CAMBIO -->
    <browser:page 
        name="alltags"
        class="ulearn5.theme.browser.views.AllTags"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/alltags.pt"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="search_filtered_news"
        class="ulearn5.theme.browser.views.SearchFilteredNews"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="contents_pretty_view"
        class="ulearn5.theme.browser.views.ContentsPrettyView"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/contentspretty.pt"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="collection_news_view"
        class="ulearn5.theme.browser.views.CollectionNewsView"
        for="zope.interface.Interface"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/collectionnews.pt"
        />

    <!-- BASE.MEMBER CAMBIO -->
    <browser:page 
        name="shared_with_me"
        class="ulearn5.theme.browser.views.SharedWithMe"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        permission="zope2.View"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.WEBMASTER CAMBIO -->
    <browser:page 
        name="reset_menu"
        class="ulearn5.theme.browser.views.ResetMenuBar"
        for="zope.interface.Interface"
        permission="cmf.ManagePortal"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.WEBMASTER CAMBIO -->
    <browser:page 
        name="reset_header"
        class="ulearn5.theme.browser.views.ResetHeader"
        for="zope.interface.Interface"
        permission="cmf.ManagePortal"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.WEBMASTER CAMBIO -->
    <browser:page 
        name="reset_footer"
        class="ulearn5.theme.browser.views.ResetFooter"
        for="zope.interface.Interface"
        permission="cmf.ManagePortal"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <browser:page 
        name="event_to_attendees"
        class="ulearn5.theme.browser.views.SendEventToAttendees"
        for="plone.dexterity.interfaces.IDexterityContent"
        permission="cmf.ModifyPortalContent"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    <!-- BASE.WEBMASTER CAMBIO -->
    <browser:page 
        name="users_communities"
        class="ulearn5.theme.browser.views.UsersCommunities"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        permission="cmf.ManagePortal"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        template="views_templates/users_communities.pt"
        />

    <!-- BASE.WEBMASTER CAMBIO -->
    <browser:page 
        name="export_users_communities"
        class="ulearn5.theme.browser.views.ExportUsersCommunities"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        permission="cmf.ManagePortal"
        layer="ulearn5.theme.interfaces.IUlearn5ThemeLayer"
        />

    



</configure>
