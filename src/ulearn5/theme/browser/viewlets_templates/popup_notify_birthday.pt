<tal:block tal:condition="not: view/isAnon" i18n:domain="ulearn">
    <div id="notify-popup-birthday" class="notify-popup" tal:condition="view/viewPopup">
        <div class="content-notify-popup">
            <span class="close-notify-popup fa fa-times" aria-hidden="true" i18n:attributes="title close_popup"
                tal:attributes="data-url string:${view/portal_url}/@@close_notify_popup_birthday" role="button"
                aria-label="Close popup"></span>
            <div tal:content="structure view/content"></div>
        </div>
    </div>
</tal:block>